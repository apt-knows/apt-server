NODE_ENV=development
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info
APT_ALLOWED_ORIGINS=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me
SUPABASE_DATABASE_URL=postgresql://postgres:replace_me@db.your-project.supabase.co:5432/postgres
SUPABASE_DATABASE_SSL=true

HERMES_VERSION=v2026.8.19
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_TOPOLOGY=per_profile
HERMES_PROFILE_URL_TEMPLATE=http://hermes-{profile}:8642
HERMES_KEY_SECRET=replace-with-at-least-32-random-characters
HERMES_HOME=/var/lib/hermes
HERMES_CLI=hermes
HERMES_PROVIDER=custom
HERMES_MODEL=apt-beta-model
HERMES_PROVIDER_BASE_URL=http://host.docker.internal:9999/v1
HERMES_PROVIDER_KEY_ENV=OPENAI_API_KEY
HERMES_PROVIDER_API_KEY=replace_me
