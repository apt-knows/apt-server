{
  "name": "apt-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "provision-user": "tsx src/admin/provision-user.ts",
    "disable-user": "tsx src/admin/disable-user.ts",
    "delete-user": "tsx src/admin/delete-user.ts",
    "test:hermes-capability": "tsx scripts/hermes-capability.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@supabase/supabase-js": "2.112.3",
    "fastify": "5.12.1",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.15.5",
    "@vitest/coverage-v8": "4.1.11",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
